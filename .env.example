# Environment variables
# Copy to .env.local for local development. Set the same values in Vercel for production.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (production domain, e.g. https://sales-master.vercel.app)
NEXT_PUBLIC_APP_URL=

# OpenAI — WhatsApp message extraction (required for WhatsApp pipeline)
OPENAI_API_KEY=
# Optional model override
WHATSAPP_EXTRACTION_MODEL=

# Google AI Studio — visiting card extraction (required for Scan card)
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
VISITING_CARD_EXTRACTION_MODEL=

# MessageAutoSender — WhatsApp gateway (required for WhatsApp inbound/outbound)
MESSAGEAUTOSENDER_BASE_URL=
MESSAGEAUTOSENDER_API_KEY=
MESSAGEAUTOSENDER_CHANNEL_ID=
MESSAGEAUTOSENDER_WEBHOOK_SECRET=

# Vercel cron — protects /api/internal/process-whatsapp (required on Vercel)
CRON_SECRET=
